<template>
  <div class="screen">
    <div class="top">
      <text class="eyebrow">NESALAB</text>
      <text class="brand">NesaOS</text>
      <text class="status">WATCH SHELL · PREVIEW</text>
    </div>

    <div class="hero">
      <text class="hero-title">{{ panelTitle }}</text>
      <text class="hero-copy">{{ panelDescription }}</text>
    </div>

    <text class="section-label">QUICK ACCESS</text>
    <list class="menu">
      <list-item for="{{items}}" class="menu-item" type="menu" onclick="openPanel($item.id)">
        <div class="menu-row">
          <div class="menu-dot" style="background-color: {{ $item.color }};"></div>
          <text class="menu-title">{{ $item.title }}</text>
          <text class="menu-arrow">›</text>
        </div>
      </list-item>
    </list>

    <text class="footer">466 × 466 target · device APIs not connected</text>
  </div>
</template>

<script>
export default {
  private: {
    panelTitle: "Your watch, your way",
    panelDescription: "A clean starting point for the NesaOS watch experience.",
    items: [
      { id: "control", title: "Nesa Control", color: "#53D6C7" },
      { id: "faces", title: "Nesa Faces", color: "#8BCBFA" },
      { id: "themes", title: "Nesa Themes", color: "#B98A68" },
      { id: "apps", title: "Apps", color: "#53D6C7" },
      { id: "settings", title: "Settings", color: "#8BCBFA" }
    ]
  },

  openPanel(id) {
    var titles = {
      control: "Nesa Control",
      faces: "Nesa Faces",
      themes: "Nesa Themes",
      apps: "Apps",
      settings: "Settings"
    }
    var descriptions = {
      control: "Device status will appear here after supported watch APIs are verified.",
      faces: "Watch face selection is planned for a later milestone.",
      themes: "Color and appearance options are planned for a later milestone.",
      apps: "The app launcher will be connected after the runtime and package format are confirmed.",
      settings: "System settings will be added only where the device exposes supported controls."
    }
    this.panelTitle = titles[id] || "NesaOS"
    this.panelDescription = descriptions[id] || "NesaOS preview"
  }
}
</script>

