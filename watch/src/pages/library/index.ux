<template><div class="page"><div class="header"><text class="back" onclick="goHome">‹</text><text class="heading">My library</text></div><div class="empty-icon"><text>◫</text></div><text class="empty-title">Your library is empty</text><text class="empty-copy">Apps you install will appear here when a supported installation method is available.</text><div class="status"><text class="status-label">STORE STATUS</text><text class="status-value">CATALOGUE PREVIEW</text><text class="status-copy">No apps have been installed by VelaStore.</text></div><div class="action" onclick="goHome"><text>Explore catalogue</text></div></div></template>
