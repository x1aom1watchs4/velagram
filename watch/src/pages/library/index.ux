<template>
  <div class="page">
    <div class="header"><text class="back" onclick="goHome">‹</text><div class="heading-copy"><text class="eyebrow">YOUR SPACE</text><text class="heading">My library</text></div></div>
    <div class="empty-icon"><text>◫</text></div>
    <text class="empty-title">{{libraryTitle}}</text>
    <text class="empty-copy">{{libraryCopy}}</text>
    <div class="status"><div class="status-dot"></div><div class="status-copy"><text class="status-label">CURRENT STATUS</text><text class="status-value">{{libraryStatus}}</text></div></div>
    <div class="action" onclick="goHome"><text>Explore apps  ↗</text></div>
  </div>
</template>
<script>
import router from '@system.router'
import storage from '@system.storage'
export default {
  private: { libraryTitle: 'Your collection starts here.', libraryCopy: 'Downloaded packages will appear here. Downloading a package does not install it automatically.', libraryStatus: 'No downloads yet' },
  onInit() {
    storage.get({ key: 'velastore_downloads', success: (res) => {
      var saved = res && res.data ? res.data : []
      if (typeof saved === 'string') { try { saved = JSON.parse(saved) } catch (e) { saved = [] } }
      if (!Array.isArray(saved) || saved.length === 0) return
      this.libraryTitle = 'Your downloads'
      this.libraryStatus = saved.length + ' package(s) saved'
      this.libraryCopy = saved.map(function (item) { return item.name + '  ·  ' + item.version }).join('\\n') + '\\n\\nPackages are downloaded, not installed.'
    }, fail: () => {} })
  },
  goHome() { router.replace({ uri: '/pages/index' }) }
}
</script>
<style>
.page{width:466px;height:466px;padding:27px 40px 22px;box-sizing:border-box;flex-direction:column;align-items:center;background-color:#111318}
.header{width:100%;height:48px;flex-direction:row;align-items:center}
.back{color:#d8c8ff;font-size:31px;width:34px}
.heading-copy{flex:1;flex-direction:column}
.eyebrow{color:#b9a6e8;font-size:8px;font-size:22px;font-weight:bold;margin-top:1px}
.empty-icon{width:83px;height:83px;margin-top:23px;border-radius:31px;background-color:#b6dfd1;justify-content:center;align-items:center}
.empty-icon text{color:#1d3931;font-size:40px}
.empty-title{color:#f2eff8;font-size:20px;font-weight:bold;text-align:center;line-height:22px;margin-top:12px}
.empty-copy{color:#c2c2cd;font-size:10px;text-align:center;line-height:15px;margin-top:8px}
.status{width:100%;height:55px;margin-top:16px;padding:9px 12px;box-sizing:border-box;border-radius:22px;background-color:#20232b;flex-direction:row;align-items:center}
.status-dot{width:10px;height:10px;border-radius:5px;background-color:#b6dfd1}
.status-copy{flex:1;margin-left:10px;flex-direction:column}
.status-label{color:#a9a5b3;font-size:7px;font-size:11px;font-weight:bold;margin-top:3px}
.action{width:100%;height:41px;margin-top:13px;border-radius:22px;background-color:#d8c8ff;justify-content:center;align-items:center}
.action text{color:#2a1b48;font-size:11px;font-weight:bold}
</style>