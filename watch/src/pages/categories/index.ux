<template><div class="page"><div class="header"><text class="back" onclick="goHome">‹</text><text class="heading">Categories</text></div><text class="intro">Browse the VelaStore catalogue</text><div class="item" onclick="openCategory('Utilities')"><text class="symbol">◷</text><div class="copy"><text class="name">Utilities</text><text class="desc">Weather, timers and tools</text></div><text class="count">2 APPS</text></div><div class="item" onclick="openCategory('Music')"><text class="symbol">♫</text><div class="copy"><text class="name">Music</text><text class="desc">Audio and media controls</text></div><text class="count">1 APP</text></div><div class="item" onclick="openCategory('Productivity')"><text class="symbol">✎</text><div class="copy"><text class="name">Productivity</text><text class="desc">Notes and focus tools</text></div><text class="count">1 APP</text></div><text class="foot">Sample catalogue categories</text><div class="action" onclick="goHome"><text>Back to home</text></div></div></template>
<script>import router from '@system.router'
export default { goHome() { router.replace({ uri: '/pages/index' }) }, openCategory(category) { router.push({ uri: '/pages/search', params: { category: category } }) } }</script>
<style>
.page{width:466px;height:466px;padding:24px;box-sizing:border-box;flex-direction:column;background-color:#141218}.header{height:48px;flex-direction:row;align-items:center}.back{color:#d0bcff;font-size:30px;width:35px}.heading{color:#e6e0e9;font-size:22px;font-weight:bold}.intro{color:#cac4d0;font-size:13px;margin-top:8px;margin-bottom:18px}.item{width:100%;height:76px;margin-bottom:10px;padding:12px;box-sizing:border-box;border-radius:18px;background-color:#211f26;flex-direction:row;align-items:center}.symbol{color:#d0bcff;font-size:24px;width:42px;text-align:center}.copy{flex:1;flex-direction:column}.name{color:#e6e0e9;font-size:16px;font-weight:bold}.desc{color:#cac4d0;font-size:11px;margin-top:4px}.count{color:#d0bcff;font-size:9px}.foot{color:#938f99;font-size:10px;text-align:center;margin-top:12px}.action{height:43px;margin-top:16px;border-radius:18px;background-color:#4f378b;justify-content:center;align-items:center}.action text{color:#fff;font-size:13px;font-weight:bold}
