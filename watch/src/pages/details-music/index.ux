<template>
  <div class="page">
    <div class="header"><text class="back" onclick="goHome">‹</text><text class="header-title">APP DETAILS</text></div>
    <div class="app-icon icon-music"><div class="disc"><div class="disc-hole"></div></div><div class="sun"></div><div class="cloud"></div><div class="timer-ring"><div class="timer-hand"></div><div class="timer-dot"></div></div><div class="paper"><div class="paper-line"></div><div class="paper-line"></div><div class="paper-line"></div></div></div>
    <text class="name">Mini Music</text><text class="category">MUSIC  ·  CATALOGUE DEMO</text>
    <text class="description">Simple music controls for your wrist, shown here as a VelaStore catalogue concept.</text>
    <div class="meta"><text>VERSION</text><text>1.0.0</text></div>
    <div class="meta"><text>PACKAGE SIZE</text><text>420 KB</text></div>
    <div class="meta"><text>COMPATIBILITY</text><text>Not verified</text></div>
    <div class="notice"><text class="notice-title">PACKAGE DOWNLOAD</text><text class="notice-copy">{{downloadStatus}}</text></div>
    <div class="action" onclick="downloadApp"><text>{{downloadLabel}}</text></div>
  </div>
</template>
<script>
import router from '@system.router'
import apps from '../../common/apps'
import request from '@system.request'
import crypto from '@system.crypto'
export default {
  private: { app: apps[0], downloadStatus: 'No verified package has been published yet.', downloadLabel: 'Package unavailable', downloading: false },
  goHome() { router.replace({ uri: '/pages/index' }) },
  downloadApp() {
    if (this.downloading) return
    var url = this.app && this.app.packageUrl
    var expected = this.app && this.app.sha256
    if (!url || !expected) {
      this.downloadStatus = 'No verified package has been published yet.'
      return
    }
    if (url.indexOf('https://') !== 0 || !/^[0-9a-fA-F]{64}$/.test(expected)) {
      this.downloadStatus = 'Package metadata is invalid. Download blocked.'
      return
    }
    this.downloading = true
    this.downloadLabel = 'Starting...'
    this.downloadStatus = 'Connecting to the package server...'
    request.download({
      url: url,
      filename: this.app.id + '-' + this.app.version + '.rpk',
      success: (task) => {
        if (!task || !task.token) {
          this.downloading = false
          this.downloadLabel = 'Try again'
          this.downloadStatus = 'The download task could not be created.'
          return
        }
        this.downloadLabel = 'Downloading...'
        this.downloadStatus = 'Download started. Checking the file when it finishes...'
        request.onDownloadComplete({
          token: task.token,
          success: (result) => {
            try {
              var actual = crypto.hashDigest({ uri: result.uri, algo: 'SHA256' })
              if (String(actual).toLowerCase() !== String(expected).toLowerCase()) {
                this.downloadStatus = 'Checksum mismatch. This package was rejected.'
                this.downloadLabel = 'Try again'
              } else {
                this.downloadStatus = 'Downloaded and SHA-256 checked. File is in the app cache.'
                this.downloadLabel = 'Downloaded'
              }
            } catch (error) {
              this.downloadStatus = 'Could not verify the downloaded file. It was not accepted.'
              this.downloadLabel = 'Try again'
            }
            this.downloading = false
          },
          fail: (error, code) => {
            this.downloading = false
            this.downloadLabel = 'Try again'
            this.downloadStatus = 'Download failed (' + code + ').'
          }
        })
      },
      fail: (error, code) => {
        this.downloading = false
        this.downloadLabel = 'Try again'
        this.downloadStatus = 'Could not start download (' + code + ').'
      }
    })
  }
}
</script>
<style>
.page{width:466px;height:466px;padding:23px 40px 20px;box-sizing:border-box;flex-direction:column;align-items:center;background-color:#111318}
.header{width:100%;height:40px;flex-direction:row;align-items:center}
.back{color:#d8c8ff;font-size:30px;width:32px}
.header-title{color:#b9b3c5;font-size:8px;height:70px;margin-top:10px;border-radius:27px;background-color:#b6dfd1;justify-content:center;align-items:center}

.app-icon{width:42px;height:42px;border-radius:17px;justify-content:center;align-items:center;flex-direction:row}
.icon-music{background-color:#a9d4c6}
.icon-weather{background-color:#ffcf9f}
.icon-timer{background-color:#a9d8d2}
.icon-notes{background-color:#e9bca8}
.disc{width:25px;height:25px;border-radius:13px;background-color:#283c38;justify-content:center;align-items:center}
.disc-hole{width:7px;height:7px;border-radius:4px;background-color:#bce6d8}
.sun{width:17px;height:17px;border-radius:9px;background-color:#a85f35;margin-right:2px}
.cloud{width:18px;height:11px;border-radius:7px;background-color:#fff1dd;margin-top:9px;margin-left:-7px}
.timer-ring{width:23px;height:23px;border-radius:12px;border-width:3px;border-color:#245e5a;justify-content:center;align-items:center}
.timer-hand{width:3px;height:9px;border-radius:2px;background-color:#245e5a;margin-top:-7px}
.timer-dot{width:4px;height:4px;border-radius:2px;background-color:#245e5a;margin-left:-4px;margin-top:4px}
.paper{width:19px;height:25px;border-radius:4px;background-color:#fff0e8;padding:5px 3px;box-sizing:border-box;flex-direction:column;justify-content:space-between}
.paper-line{width:12px;height:2px;border-radius:1px;background-color:#9a5b49}

.name{color:#f2eff8;font-size:22px;font-weight:bold;margin-top:8px}
.category{color:#cbb8ff;font-size:8px;margin-top:4px}
.description{color:#d0ccd8;font-size:11px;text-align:center;margin-top:13px;line-height:16px;width:100%}
.meta{width:100%;height:31px;margin-top:5px;padding:0 4px;flex-direction:row;justify-content:space-between;align-items:center;border-bottom-width:1px;border-bottom-color:#343642}
.meta text{color:#bdb9c8;font-size:9px}
.notice{width:100%;margin-top:10px;padding:10px;box-sizing:border-box;border-radius:20px;background-color:#333044;flex-direction:column}
.notice-title{color:#e4d8ff;font-size:9px;font-weight:bold}
.notice-copy{color:#d0c8df;font-size:8px;margin-top:4px}
.action{width:100%;height:39px;margin-top:11px;border-radius:21px;background-color:#d8c8ff;justify-content:center;align-items:center}
.action text{color:#2a1b48;font-size:11px;font-weight:bold}

.disc,.sun,.cloud,.timer-ring,.paper{display:none}
.icon-music .disc{display:flex}
.icon-weather .sun{display:flex}
.icon-weather .cloud{display:flex}
.icon-timer .timer-ring{display:flex}
.icon-notes .paper{display:flex}
</style>