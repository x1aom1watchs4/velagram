<template>
  <div class="page">
    <div class="header"><text class="back" onclick="goBack">‹</text><text class="title">Search apps</text></div>
    <input class="search-input" placeholder="Search by name or category" value="{{query}}" oninput="searchApps" />
    <text class="count">{{results.length}} MATCHING APPS</text>
    <list class="list"><list-item for="{{results}}" class="item" type="app" onclick="openDetails($item.id)"><div class="row"><div class="app-icon" style="background-color: {{ $item.color }};"><text class="symbol">{{ $item.symbol }}</text></div><div class="copy"><text class="name">{{ $item.name }}</text><text class="meta">{{ $item.category }}  ·  {{ $item.status }}</text></div><text class="arrow">›</text></div></list-item></list>
    <text class="foot" onclick="goHome">HOME</text>
  </div>
</template>
<script>
import router from '@system.router'
import apps from '../../common/apps'
export default {
  private: { query: '', results: apps },
  onInit() {
    var category = this.$page && this.$page.params ? this.$page.params.category : ''
    if (category) { this.query = category; this.searchApps(category) }
  },
  searchApps(value) {
    this.query = value
    var q = (value || '').toLowerCase()
    this.results = apps.filter(function (app) {
      return app.name.toLowerCase().indexOf(q) >= 0 || app.category.toLowerCase().indexOf(q) >= 0 || app.description.toLowerCase().indexOf(q) >= 0
    })
  },
  goBack() { router.back() },
  goHome() { router.replace({ uri: '/pages/index' }) },
  openDetails(id) { router.push({ uri: '/pages/details', params: { appId: id } }) }
}
</script>
<style>
.page{width:466px;height:466px;padding:20px 23px;box-sizing:border-box;flex-direction:column;background-color:#0d151d}.header{width:100%;height:44px;flex-direction:row;align-items:center}.back{color:#75c9e8;font-size:30px;width:35px}.title{color:#f4f8fb;font-size:21px;font-weight:bold}.search-input{width:100%;height:46px;margin-top:14px;padding:0 12px;border-radius:12px;background-color:#17232e;color:#fff;font-size:13px}.count{color:#79a7bd;font-size:9px;letter-spacing:1px;margin-top:14px;margin-bottom:8px}.list{width:100%;flex:1}.item{width:100%;height:57px;margin-bottom:6px;border-radius:11px;background-color:#17232e}.row{flex:1;padding:7px 10px;flex-direction:row;align-items:center}.app-icon{width:38px;height:38px;border-radius:11px;justify-content:center;align-items:center}.symbol{color:#fff;font-size:21px}.copy{flex:1;margin-left:10px;flex-direction:column}.name{color:#f3f7fa;font-size:13px;font-weight:bold}.meta{color:#8eabba;font-size:9px;margin-top:3px}.arrow{color:#8ca9ba;font-size:21px}.foot{color:#70c7eb;font-size:11px;text-align:center;margin-top:9px}
</style>