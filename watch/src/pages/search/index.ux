<template>
  <div class="page">
    <div class="header"><text class="back" onclick="goBack">‹</text><div class="heading-copy"><text class="eyebrow">VELASTORE</text><text class="title">Find an app</text></div></div>
    <div class="search-shell"><text class="search-icon">⌕</text><input class="search-input" placeholder="Search apps or categories" value="{{query}}" oninput="searchApps" /></div>
    <div class="result-heading"><text class="count">YOUR RESULTS</text><text class="count-number">{{results.length}}</text></div>
    <list class="list"><list-item for="{{results}}" class="item" type="app" onclick="openDetails($item.id)"><div class="row"><div class="app-icon" style="background-color: {{ $item.color }};"><text class="symbol">{{ $item.symbol }}</text></div><div class="copy"><text class="name">{{ $item.name }}</text><text class="meta">{{ $item.category }}  ·  {{ $item.status }}</text></div><div class="arrow-wrap"><text class="arrow">›</text></div></div></list-item></list>
    <text class="foot" onclick="goHome">BACK TO STORE</text>
  </div>
</template>
<script>
import router from '@system.router'
import apps from '../../common/apps'
export default {
  private: { query: '', results: apps },
  onInit() {
    var category = this.$page && this.$page.params ? this.$page.params.category : ''
    if (category) { this.query = category; this.searchApps(category) }
  },
  searchApps(value) {
    this.query = value
    var q = (value || '').toLowerCase()
    this.results = apps.filter(function (app) {
      return app.name.toLowerCase().indexOf(q) >= 0 || app.category.toLowerCase().indexOf(q) >= 0 || app.description.toLowerCase().indexOf(q) >= 0
    })
  },
  goBack() { router.back() },
  goHome() { router.replace({ uri: '/pages/index' }) },
  openDetails(id) { router.push({ uri: '/pages/details', params: { appId: id } }) }
}
</script>
<style>
.page{width:466px;height:466px;padding:25px 39px 18px;box-sizing:border-box;flex-direction:column;background-color:#111318}
.header{width:100%;height:48px;flex-direction:row;align-items:center}
.back{color:#d8c8ff;font-size:31px;width:34px}
.heading-copy{flex:1;flex-direction:column}
.eyebrow{color:#b9a6e8;font-size:8px;font-size:21px;font-weight:bold;margin-top:1px}
.search-shell{width:100%;height:48px;margin-top:12px;padding:0 12px;box-sizing:border-box;border-radius:24px;background-color:#282b35;flex-direction:row;align-items:center}
.search-icon{color:#d8c8ff;font-size:24px;width:28px}
.search-input{flex:1;height:42px;background-color:transparent;color:#f2eff8;font-size:11px}
.result-heading{width:100%;height:27px;margin-top:9px;flex-direction:row;align-items:center;justify-content:space-between}
.count{color:#bdb6cc;font-size:8px;font-size:11px;font-weight:bold}
.list{width:100%;flex:1}
.item{width:100%;height:58px;margin-bottom:7px;border-radius:22px;background-color:#20232b}
.row{flex:1;padding:7px 9px;flex-direction:row;align-items:center}
.app-icon{width:41px;height:41px;border-radius:17px;justify-content:center;align-items:center}
.symbol{color:#20202a;font-size:21px}
.copy{flex:1;margin-left:10px;flex-direction:column}
.name{color:#f2eff8;font-size:12px;font-weight:bold}
.meta{color:#bdb9c8;font-size:8px;margin-top:3px}
.arrow-wrap{width:25px;height:25px;border-radius:13px;background-color:#35313f;justify-content:center;align-items:center}
.arrow{color:#dfd2ff;font-size:20px}
.foot{color:#cbb8ff;font-size:8px;text-align:center;margin-top:8px}
</style>