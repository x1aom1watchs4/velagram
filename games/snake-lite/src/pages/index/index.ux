<template>
  <div class="page">
    <text class="eyebrow">VELA MINI GAMES · 04</text>
    <text class="title">Snake Lite</text>
    <text class="subtitle">Move around the grid and collect dots</text>
    <text class="score">SCORE {{score}}</text>
    <div class="board">
      <div class="row"><div class="{{cellClass(0)}}"></div><div class="{{cellClass(1)}}"></div><div class="{{cellClass(2)}}"></div><div class="{{cellClass(3)}}"></div><div class="{{cellClass(4)}}"></div></div>
      <div class="row"><div class="{{cellClass(5)}}"></div><div class="{{cellClass(6)}}"></div><div class="{{cellClass(7)}}"></div><div class="{{cellClass(8)}}"></div><div class="{{cellClass(9)}}"></div></div>
      <div class="row"><div class="{{cellClass(10)}}"></div><div class="{{cellClass(11)}}"></div><div class="{{cellClass(12)}}"></div><div class="{{cellClass(13)}}"></div><div class="{{cellClass(14)}}"></div></div>
      <div class="row"><div class="{{cellClass(15)}}"></div><div class="{{cellClass(16)}}"></div><div class="{{cellClass(17)}}"></div><div class="{{cellClass(18)}}"></div><div class="{{cellClass(19)}}"></div></div>
      <div class="row"><div class="{{cellClass(20)}}"></div><div class="{{cellClass(21)}}"></div><div class="{{cellClass(22)}}"></div><div class="{{cellClass(23)}}"></div><div class="{{cellClass(24)}}"></div></div>
    </div>
    <div class="controls"><div class="control" onclick="move('left')"><text>‹</text></div><div class="control" onclick="move('up')"><text>↑</text></div><div class="control" onclick="move('down')"><text>↓</text></div><div class="control" onclick="move('right')"><text>›</text></div></div>
    <div class="reset" onclick="resetGame"><text>RESTART</text></div>
  </div>
</template>
<script>
export default {
  private: { x: 2, y: 2, food: 18, score: 0, over: false },
  cellClass(index) {
    var x=index%5, y=Math.floor(index/5)
    if(x===this.x && y===this.y) return 'cell snake'
    if(x===this.food%5 && y===Math.floor(this.food/5)) return 'cell food'
    return 'cell'
  },
  move(direction) {
    if(this.over)return
    if(direction==='left')this.x-=1
    if(direction==='right')this.x+=1
    if(direction==='up')this.y-=1
    if(direction==='down')this.y+=1
    if(this.x<0||this.x>4||this.y<0||this.y>4){this.over=true;return}
    var pos=this.y*5+this.x
    if(pos===this.food){this.score+=1;this.food=(this.food+7)%25;if(this.food===pos)this.food=(this.food+3)%25}
  },
  resetGame(){this.x=2;this.y=2;this.food=18;this.score=0;this.over=false}
}
</script>
<style>
.page{width:466px;height:466px;padding:26px 65px 15px;box-sizing:border-box;align-items:center;flex-direction:column;background-color:#111318}
.eyebrow{color:#b9dca5;font-size:8px;margin-top:1px}
.title{color:#f2eff8;font-size:25px;font-weight:bold;margin-top:5px}
.subtitle{color:#c4bfce;font-size:8px;margin-top:4px}
.score{color:#b9dca5;font-size:10px;font-weight:bold;margin-top:8px}
.board{width:190px;height:190px;padding:5px;box-sizing:border-box;border-radius:14px;background-color:#253226;flex-direction:column;margin-top:8px}
.row{width:100%;height:20%;flex-direction:row;justify-content:space-around;align-items:center}
.cell{width:30px;height:30px;border-radius:7px;background-color:#354637}
.snake{background-color:#b9dca5}
.food{background-color:#ffcf9f;border-radius:15px}
.controls{width:218px;flex-direction:row;justify-content:space-between;margin-top:10px}
.control{width:43px;height:32px;border-radius:16px;background-color:#b9dca5;justify-content:center;align-items:center}
.control text{color:#20351d;font-size:20px;font-weight:bold}
.reset{width:118px;height:30px;border-radius:15px;background-color:#29342a;justify-content:center;align-items:center;margin-top:7px}
.reset text{color:#d6efc8;font-size:8px;font-weight:bold}
</style>